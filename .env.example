# QRadar (Ariel searches)
QRADAR_HOST=qradar.example.com
QRADAR_API_TOKEN=your-authorized-service-token
QRADAR_VERIFY_SSL=true
AQL_TIMEOUT_SECONDS=300

# ServiceNow
SERVICENOW_INSTANCE=your-instance
SERVICENOW_USERNAME=svc-security-notifications
SERVICENOW_PASSWORD=your-password
SERVICENOW_VERIFY_SSL=true
# Table and fields of the security notification record (a ServiceNow notification mails it to the user)
SERVICENOW_TABLE=u_security_notification
SERVICENOW_BODY_FIELD=u_body
SERVICENOW_RECIPIENT_FIELD=u_user_email

# IBM QRadar SOAR (CLI only; the app function uses its own connection)
SOAR_HOST=soar.example.com
SOAR_PORT=443
SOAR_ORG=Example Org
SOAR_API_KEY_ID=your-api-key-id
SOAR_API_KEY_SECRET=your-api-key-secret
SOAR_CAFILE=
# Incident field that stores the notified user's address
SOAR_RECIPIENT_PROPERTY=qradar_user_email
